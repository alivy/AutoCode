<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AutoCode.Plugins.DependencyInjection</RootNamespace>
    <Description>AutoCode DI 插件 - 编译时依赖注入注册代码生成（支持 Keyed Services、开放泛型、装饰器）</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCode.Engine\AutoCode.Engine.csproj" />
    <ProjectReference Include="..\AutoCode.Model\AutoCode.Model.csproj" />
  </ItemGroup>

</Project>
