<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- 启用 AOT 兼容性分析，验证生成代码无反射依赖 -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- 将 autocode.json 内容传递给 Source Generator（位于仓库根目录） -->
    <AutoCode_ConfigJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\autocode.json'))</AutoCode_ConfigJson>
  </PropertyGroup>

  <ItemGroup>
    <!-- 暴露给 Source Generator 读取 -->
    <CompilerVisibleProperty Include="AutoCode_ConfigJson" />
    <!-- 模板文件作为 AdditionalFiles 传递给 CustomRecipeGenerator（位于仓库根目录 templates/） -->
    <AdditionalFiles Include="..\..\templates\*.liquid" />
  </ItemGroup>

  <ItemGroup>
    <!-- 统一代码生成器（11合1：接口/映射/DTO/验证/Controller/DI/日志/测试/CRUD/级联/拦截）-->
    <ProjectReference Include="..\AutoCode.Generators\AutoCode.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- 分析器 + CodeFix + 右键重构 -->
    <ProjectReference Include="..\AutoCode.Analyzers\AutoCode.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- 契约层（Attribute + Handler 接口）-->
    <ProjectReference Include="..\AutoCode.Model\AutoCode.Model.csproj" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\APP.WebAPI.Core\APP.WebAPI.Core.csproj" />
  </ItemGroup>

</Project>
