<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<!--打Nuget包信息-->
		<PackageId>AM.AutoCode</PackageId>
		<Version>2.3.0</Version>
		<Company>AMiao</Company>
		<Authors>AMiao</Authors>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<Description>自动代码生成扩展 - 统一生成器（接口/映射/DTO/验证/Controller/DI/日志/测试/CRUD/级联/拦截）+ 分析器与代码修复。编译时生成，零运行时反射，NativeAOT 兼容。</Description>
		<Summary>自动代码生成扩展</Summary>
		<PackageTags>source-generator;roslyn;aot;trimming;code-generation;analyzer</PackageTags>
		<copyright>Copyright © AMiao 2024</copyright>
		<language>zh-Hans-CN</language>
		<Configurations>Debug;Release;Publish</Configurations>
		<PackageIcon>Icon.png</PackageIcon>
		<RepositoryUrl>https://gitee.com/miaolove/auto-code</RepositoryUrl>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<PackageProjectUrl>https://gitee.com/miaolove/auto-code</PackageProjectUrl>
		<!--标记为开发依赖，不会传递到运行时依赖-->
		<DevelopmentDependency>true</DevelopmentDependency>
		<IncludeBuildOutput>false</IncludeBuildOutput>
	</PropertyGroup>

	<!-- 解决方案目录定义，解决独立构建时 SolutionDir 为 Undefined 的问题 -->
	<PropertyGroup>
		<SolutionDir Condition="'$(SolutionDir)' == '' OR '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)../</SolutionDir>
		<NugetOutputPath>$(SolutionDir).nuget\</NugetOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Icon.png" PackagePath="\" Pack="True" />
		<None Include="NugetPackage\tools\*.*" PackagePath="tools" Pack="true" />
		<None Include="NugetPackage\lib\netstandard2.1\**" PackagePath="lib\netstandard2.1" Pack="true" />
		<None Include="NugetPackage\analyzers\dotnet\cs\**" PackagePath="analyzers\dotnet\cs" Pack="true" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="NugetPackage\lib\netstandard2.1\" />
	</ItemGroup>

	<!--生成前事件：仅在 Publish 配置时执行，发布统一生成器/分析器/模板生成器和模型到 NugetPackage 目录 -->
	<!-- AutoCode.Generators 合并了全部 V1/V2 生成器，publish 输出自动携带 AutoCode.Model.dll / AutoCode.Engine.dll / System.Text.Json.dll 等依赖，
	     保证分析器加载上下文能找到依赖程序集 -->
	<Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition="'$(Configuration)' == 'Publish'">
		<Exec Command="dotnet publish ../AutoCode.Generators/AutoCode.Generators.csproj -c Release -o NugetPackage/analyzers/dotnet/cs" />
		<Exec Command="dotnet publish ../AutoCode.Analyzers/AutoCode.Analyzers.csproj -c Release -o NugetPackage/analyzers/dotnet/cs" />
		<Exec Command="dotnet publish ../AutoCode.XmlTemplate.SourceGenerator/AutoCode.DotTemplate.SourceGenerator.csproj -c Release -o NugetPackage/analyzers/dotnet/cs" />
		<Exec Command="dotnet publish ../AutoCode.Model/AutoCode.Model.csproj -c Release -o NugetPackage/lib/netstandard2.1" />
	</Target>

	<!--生成后事件：仅在 Publish 配置时打包 Nuget -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Publish'">
		<Exec Command="if not exist &quot;$(NugetOutputPath)&quot; mkdir &quot;$(NugetOutputPath)&quot;&#xD;&#xA;dotnet pack $(ProjectDir)$(ProjectName).csproj --no-build -c Publish -o &quot;$(NugetOutputPath)&quot;" />
	</Target>
</Project>
