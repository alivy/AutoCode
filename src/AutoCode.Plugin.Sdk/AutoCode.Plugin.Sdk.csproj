<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AutoCode.Plugin.Sdk</RootNamespace>
    <PackageId>AM.AutoCode.Plugin.Sdk</PackageId>
    <Version>2.0.0</Version>
    <Description>AutoCode 插件开发 SDK - 第三方开发者用此包创建自定义代码生成器插件</Description>
    <Authors>AMiao</Authors>
    <PackageTags>autocode;sourcegenerator;plugin;sdk;roslyn</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCode.Engine\AutoCode.Engine.csproj" />
    <ProjectReference Include="..\AutoCode.Model\AutoCode.Model.csproj" />
  </ItemGroup>

</Project>
