<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AutoCode.Plugins.WebApi</RootNamespace>
    <Description>AutoCode WebApi 插件 - 生产级 API Controller 生成（统一响应、分页、版本控制、授权）</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCode.Engine\AutoCode.Engine.csproj" />
    <ProjectReference Include="..\AutoCode.Model\AutoCode.Model.csproj" />
  </ItemGroup>

</Project>
