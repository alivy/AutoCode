<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AutoCode.Plugins.Validation</RootNamespace>
    <Description>AutoCode Validation 插件 - 编译时验证代码生成（支持全部 DataAnnotations + 跨属性 + 集合验证）</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCode.Engine\AutoCode.Engine.csproj" />
    <ProjectReference Include="..\AutoCode.Model\AutoCode.Model.csproj" />
  </ItemGroup>

</Project>
