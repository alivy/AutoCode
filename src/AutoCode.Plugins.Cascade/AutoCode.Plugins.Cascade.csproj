<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AutoCode.Plugins.Cascade</RootNamespace>
    <Description>AutoCode Cascade 插件 - [AutoEntity] 一个标记触发全链路生成（DTO+Mapper+Validator+Repository+Service+Controller）</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCode.Engine\AutoCode.Engine.csproj" />
    <ProjectReference Include="..\AutoCode.Model\AutoCode.Model.csproj" />
  </ItemGroup>

</Project>
