{
  "$schema": "http://json.schemastore.org/template",
  "author": "AMiao",
  "classifications": ["Web", "WebAPI", "AutoCode", "Source Generator"],
  "identity": "AM.AutoCode.Templates.WebApi",
  "name": "AutoCode WebAPI (全链路代码生成)",
  "shortName": "autocode-webapi",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "AutoCodeWebApiTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "enableCrud": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "启用 CRUD 全链路生成"
    },
    "enableIntercept": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "启用 AOP 拦截器（Log/Cache/Retry/Metrics）"
    },
    "enableValidation": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "启用编译时验证生成"
    }
  }
}
